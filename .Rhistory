}  else print("1 and 0 is FALSE!")
if(0 & 1) {
print("0 and 1 is TRUE!")
}  else print("0 and 1 is FALSE!")
# TRUE and TRUE
# This is like saying, "Is it sunny AND can you go?"
# Since both are true, the answer is TRUE!
1 & 1
if(1 & 1) {
print("1 and 1 is TRUE!")
}  else print("Hmm, that's not right.")
# TRUE and FALSE
# This is like saying, "Is it sunny AND can you go?" but you can't go.
# Since one thing is FALSE, the whole answer is FALSE!
1 & 0
if(1 & 0) {
print("1 and 0 is TRUE!")
}  else print("1 and 0 is FALSE!")
# FALSE and TRUE
# This is like saying, "Is it sunny AND can you go?" but it's not sunny.
# Since one thing is FALSE, the whole answer is FALSE!
0 & 1
if(0 & 1) {
print("0 and 1 is TRUE!")
}  else print("0 and 1 is FALSE!")
# FALSE and FALSE
# This is like saying, "Is it sunny AND can you go?" but it's not sunny and you can't go.
# Since both are FALSE, the whole answer is FALSE!
0 & 0
if(0 & 0) {
print("0 and 0 is TRUE!")
}  else print("0 and 0 is FALSE!")
# TRUE or TRUE
# You get ice cream AND a cookie. Awesome! The answer is TRUE.
1 | 1
if(1 | 1) {
print("1 or 1 is TRUE!")
}  else print("Hmm, that's not right.")
# TRUE or FALSE
# You get ice cream but no cookie. You still get a treat! The answer is TRUE.
1 | 0
if(1 | 0) {
print("1 or 0 is TRUE!")
}  else print("Hmm, that's not right.")
# FALSE or TRUE
# No ice cream but you get a cookie! Yum! The answer is TRUE.
0 | 1
if(0 | 1) {
print("0 or 1 is TRUE!")
}  else print("Hmm, that's not right.")
# FALSE or FALSE
# No ice cream AND no cookie. Aww. The only time the answer is FALSE!
0 | 0
if(0 | 0) {
print("0 or 0 is TRUE!")
}  else print("0 or 0 is FALSE!")
# NOT TRUE
# It flips the special word TRUE to FALSE.
!1
if(!1) {
print("!1 is TRUE!")
}  else print("!1 is FALSE!")
# NOT FALSE
# It flips the special word FALSE to TRUE.
!0
if(!0) {
print("!0 is TRUE!")
}  else print("!0 is FALSE!")
