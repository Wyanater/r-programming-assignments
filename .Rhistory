# Install the 'sqldf' package if it's not already installed.
install.packages("sqldf")
# Activate the 'sqldf' package to enable its functions.
# The sqldf package allows running SQL queries directly on R data frames.
library(sqldf)
# (a) Make sure the built-in "airquality" dataset is available.
# Print the first few rows (head) of the airquality data frame to verify it's loaded
# and to inspect the column names.
head(airquality)
# (b) Assign the 'airquality' dataset to an object named "air".
# This creates a copy of the data frame to work with, as required by the lab.
air <- airquality
# (c) Reveal the data type of the object "air".
# The 'class()' function returns the internal R class of an object.
class(air)
# (a) Use sqldf() to run an SQL SELECT command.
# The SQL statement calculates the average (AVG) of the 'Ozone' column
# from the R data frame 'air'.
# Note: SQL's AVG automatically ignores NULL values (NAs).
# The result is assigned to the variable 'average_ozone'.
average_ozone <- sqldf("SELECT AVG(Ozone) FROM air")
# (b) Print the calculated average ozone level.
print(average_ozone)
newAQ_sql <- sqldf("
SELECT *
FROM air
WHERE Ozone > (SELECT AVG(Ozone) FROM air)
")
# (a) Write the result table into a new R data object called "newAQ".
# The result from the combined query is already assigned to 'newAQ_sql'.
newAQ <- newAQ_sql
# (b) Reveal what type of object newAQ is.
# The result of sqldf() is always an R data frame.
class(newAQ)
# (c) Show the dimensions (rows and columns) of the result.
# The 'dim()' function returns a vector: c(number_of_rows, number_of_columns).
dim(newAQ)
# (d) Show the first few rows of the filtered data frame.
head(newAQ)
# (a) Exclude Missing Values (NA) from the "Ozone" column when calculating the mean
# and assign the result to "average_ozone".
# The 'mean()' function is used with the 'na.rm = TRUE' argument to safely ignore NAs.
average_ozone_r <- mean(air$Ozone, na.rm = TRUE)
# (b) Print the result (average_ozone_r).
print(average_ozone_r)
# (d) Only keep the rows where Ozone values are higher than the average,
# and write the result table into a new R data object called "newAQ2".
# This uses **logical indexing**: we select all rows (comma before the second index)
# where the condition (air$Ozone > average_ozone_r) is TRUE, and all columns.
newAQ2 <- air[air$Ozone > average_ozone_r, ]
# (e) Reveal what type of object newAQ2 is.
class(newAQ2)
# (f) Reveal the number of rows, then reveal the number of columns.
# The 'dim()' function is the simplest way to get both.
dim(newAQ2)
# (g) Show the first few rows of "newAQ2".
head(newAQ2)
